---
import { Image } from 'astro:assets';
import { getProjects } from '@/data/projects';
import { getUI, type Language } from '@/i18n/ui';
import SectionLabel from './SectionLabel.astro';
import Arrow from './Arrow.astro';
interface Props {
  lang: Language;
  reveal?: boolean;
}
const { lang, reveal = false } = Astro.props;
const t = getUI(lang);
const projects = getProjects(lang);
---

<section
  id={reveal ? undefined : 'proyectos'}
  class:list={['work-chapter', { 'work-chapter-reveal': reveal }]}
  aria-labelledby={reveal ? undefined : 'work-title'}
  aria-hidden={reveal ? 'true' : undefined}
  inert={reveal}
>
  <div class="work-stage page-gutter">
    <div class="chapter-heading">
      <SectionLabel number="02" text={t.work.label} />
      <span class="chapter-counter font-mono" aria-hidden="true">
        {t.work.active}{' '}
        <span
          data-work-counter={reveal ? undefined : true}
          data-work-reveal-counter={reveal ? true : undefined}
        >
          01
        </span>{' '}
        / 05
      </span>
      <h2 id={reveal ? undefined : 'work-title'}>
        {t.work.lines.map((line) => (
          <span>{line}</span>
        ))}
      </h2>
      <p>{t.work.description}</p>
    </div>
    <ol class="project-list" aria-label={reveal ? undefined : t.work.collection}>
      {projects.map((p, i) => (
        <li
          class:list={['project-item', { 'is-active': i === 0 }]}
          data-project-index={reveal ? undefined : i}
          data-project-reveal-index={reveal ? i : undefined}
        >
          <button
            class="project-row"
            type="button"
            data-dialog-open={reveal ? undefined : `project-${p.id}`}
            aria-haspopup={reveal ? undefined : 'dialog'}
            aria-label={reveal ? undefined : `${t.work.open}: ${p.name}`}
            tabindex={reveal ? -1 : undefined}
          >
            <span class="project-meta font-mono">
              <span>[ {p.category} ]</span>
              <span>{p.scope}</span>
            </span>
            <span class="project-name">{p.name}</span>
            <span class="axis-number font-mono">{p.number}</span>
            <span class="project-detail">
              <span class="font-mono">{p.category}</span>
              <span class="project-description">{p.description}</span>
            </span>
            <Arrow class="project-arrow" />
          </button>
        </li>
      ))}
    </ol>
    <div class="chapter-foot font-mono">
      <span>ATS — {t.work.label.toUpperCase()}</span>
      <span>
        {t.work.open} <span aria-hidden="true">↗</span>
      </span>
    </div>
  </div>
</section>
{!reveal &&
  projects.map((p) => (
    <dialog
      id={`project-${p.id}`}
      class="project-dialog"
      aria-labelledby={`title-${p.id}`}
      data-lenis-prevent
    >
      <div class="dialog-top project-dialog-top">
        <span class="font-mono">
          {p.number} / {t.work.label}
        </span>
        <button type="button" class="close-button" data-dialog-close aria-label={t.close}>
          {t.close}
          <span aria-hidden="true">×</span>
        </button>
      </div>
      <div class="project-dialog-scroll" data-project-dialog-scroll>
        <div class="project-dialog-heading">
          <div>
            <p class="font-mono">{p.category}</p>
            <h2 id={`title-${p.id}`}>{p.name}</h2>
          </div>
          {p.url && (
            <a class="text-link" href={p.url} target="_blank" rel="noopener noreferrer">
              {t.work.visit}
              <Arrow />
            </a>
          )}
        </div>
        <Image
          src={p.image}
          alt={`${p.name} — ${p.category}`}
          width={1400}
          format="webp"
          quality={85}
          loading="lazy"
          class="project-cover"
        />
        <div class="project-dialog-description">
          <p>{p.description}</p>
          <span class="font-mono">{p.scope}</span>
        </div>
      </div>
      <span class="dialog-scroll-indicator" data-dialog-scroll-indicator aria-hidden="true">
        <span></span>
      </span>
    </dialog>
  ))}
